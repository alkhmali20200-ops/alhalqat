rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== دوال مساعدة ======

    // هل المستخدم مسجل دخوله؟
    function isAuth() {
      return request.auth != null;
    }

    // هل المستخدم مسؤول نظام؟
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // هل المستخدم مسؤول أو مشرف؟
    function isSupervisorOrAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'supervisor'];
    }

    // ====== قواعد البيانات ======

    // البيانات الرئيسية للتطبيق (الحلقات والطلاب)
    // يتطلب تسجيل الدخول - لا يمكن لأي شخص خارجي القراءة أو الكتابة
    match /artifacts/{appId}/public/data {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // بيانات المستخدمين وصلاحياتهم
    match /users/{userId} {
      // كل مستخدم يقرأ بياناته فقط، والمسؤول يقرأ الكل
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      // فقط المسؤول يضيف أو يعدل أو يحذف المستخدمين
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // المستخدمون المعلقون (أضافهم المسؤول قبل تسجيلهم)
    match /pendingUsers/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // سجل التبرعات
    // القراءة: لجميع المستخدمين المسجلين
    // الكتابة: المسؤول والمشرف فقط
    match /donations/{donationId} {
      allow read: if isAuth();
      allow write: if isSupervisorOrAdmin();
    }

    // إعدادات الجمعية
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
